LLM_MODEL_NAME=qwen-max
LLM_API_KEY=
LLM_BASE_URL=
SUB_AGENT_MAX_CONCURRENCY=50
ITEM_INDEX_ROOT=data/indexes

# 会话级上下文治理
AGENT_SESSION_ROOT=data/sessions
LLM_CONTEXT_WINDOW=131072
CONTEXT_LLM_ENABLED=true
COMPRESSION_LLM_MODEL=qwen-max
COMPRESSION_LLM_MAX_TOKENS=2048
CONTEXT_SUMMARY_TRIGGER_RATIO=0.70
CONTEXT_FORCED_SUMMARY_RATIO=0.85
CONTEXT_EMERGENCY_RATIO=0.95
CONTEXT_TARGET_RATIO=0.60
CONTEXT_HOT_MESSAGE_COUNT=8
CONTEXT_MIN_SUMMARY_TOKENS=2048
CONTEXT_MAX_COMPRESSION_INPUT_TOKENS=16000
CONTEXT_TOOL_OFFLOAD_TOKENS=4000
CONTEXT_TOOL_PREVIEW_CHARS=1000
CONTEXT_EPOCH_MAX_MODEL_CALLS=20
CONTEXT_FROZEN_RATIO=0.50
CONTEXT_REPEATED_COMPACTIONS_TO_ROLL=3

# Qwen 显式缓存默认关闭；隐式前缀缓存仍可自动生效。
LLM_CACHE_PROVIDER=auto
LLM_EXPLICIT_CACHE=false

