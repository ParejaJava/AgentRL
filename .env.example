LLM_MODEL_NAME=qwen-max
LLM_API_KEY=
LLM_BASE_URL=
SUB_AGENT_MAX_CONCURRENCY=50
ITEM_INDEX_ROOT=data/indexes
ITEM_SEARCH_INDEX_ID=evaluation-products

# 品类知识：结构化模型只在离线摄取命令中调用。
CATEGORY_KNOWLEDGE_ROOT=knowledge
CATEGORY_CARD_STORE=data/category_insight/cards.jsonl
CATEGORY_INGESTION_MANIFEST=data/category_insight/manifest.json
CATEGORY_STRUCTURING_MODEL=qwen-max
CATEGORY_STRUCTURING_MAX_TOKENS=4096
CATEGORY_QUICK_RECALL_K=8
CATEGORY_DEEP_RECALL_K=20
CATEGORY_MIN_CONFIDENCE=0.6
CATEGORY_RETRIEVER_BACKEND=opensearch
CATEGORY_EMBEDDING_MODEL=BAAI/bge-m3
CATEGORY_EMBEDDING_DIMENSION=1024
CATEGORY_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CATEGORY_HYBRID_RECALL_K=50

# 本地 Docker OpenSearch；生产环境必须启用 TLS 与认证。
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_TIMEOUT_SECONDS=10
OPENSEARCH_CATEGORY_INDEX=globex_category_kb
OPENSEARCH_CATEGORY_PIPELINE=globex-category-rrf
OPENSEARCH_BM25_WEIGHT=0.4
OPENSEARCH_KNN_WEIGHT=0.6

# 会话级上下文治理
AGENT_SESSION_ROOT=data/sessions
LLM_CONTEXT_WINDOW=131072
CONTEXT_LLM_ENABLED=true
COMPRESSION_LLM_MODEL=qwen-max
COMPRESSION_LLM_MAX_TOKENS=2048
CONTEXT_SUMMARY_TRIGGER_RATIO=0.70
CONTEXT_FORCED_SUMMARY_RATIO=0.85
CONTEXT_EMERGENCY_RATIO=0.95
CONTEXT_TARGET_RATIO=0.60
CONTEXT_HOT_MESSAGE_COUNT=8
CONTEXT_MIN_SUMMARY_TOKENS=2048
CONTEXT_MAX_COMPRESSION_INPUT_TOKENS=16000
CONTEXT_TOOL_OFFLOAD_TOKENS=4000
CONTEXT_TOOL_PREVIEW_CHARS=1000
CONTEXT_EPOCH_MAX_MODEL_CALLS=20
CONTEXT_FROZEN_RATIO=0.50
CONTEXT_REPEATED_COMPACTIONS_TO_ROLL=3

# Qwen 显式缓存默认关闭；隐式前缀缓存仍可自动生效。
LLM_CACHE_PROVIDER=auto
LLM_EXPLICIT_CACHE=false

