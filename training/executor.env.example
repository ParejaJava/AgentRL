# Optional executor override. Leave unset to reuse the existing planner model.
EXECUTOR_MODEL_NAME=globex-executor-v1
EXECUTOR_BASE_URL=http://127.0.0.1:8010/v1
EXECUTOR_API_KEY=local-no-key
EXECUTOR_CONTEXT_WINDOW=4096
# Optional version names served by the SAME executor endpoint:
# EXECUTOR_FALLBACK_MODEL=
# EXECUTOR_LITE_MODEL=
# Opt-in local capture; raw records may contain personal information.
TRAJECTORY_ROOT=data/trajectories
